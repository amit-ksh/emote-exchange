# Optional: leave these empty for Demo mode. Twitch integration arrives in Sprint 1.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# The server always listens on 127.0.0.1. Update both values together if changing port.
PORT=4100
PUBLIC_ORIGIN=http://localhost:4100
DATA_DIR=./data

# Future live EventSub endpoints. Override only for the Twitch CLI mock server.
EVENTSUB_WS_URL=wss://eventsub.wss.twitch.tv/ws
EVENTSUB_SUBSCRIPTIONS_URL=https://api.twitch.tv/helix/eventsub/subscriptions
