# Optional: leave these empty for Demo mode. Required for Twitch sign-in and live events.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Local is the default. Hosted mode binds 0.0.0.0 and requires HTTPS and owner sign-in.
DEPLOYMENT_MODE=local
# Required only in hosted mode: your lowercase Twitch login.
TWITCH_OWNER_LOGIN=
# Local mode: update PORT and PUBLIC_ORIGIN together. Render supplies PORT.
PORT=4100
PUBLIC_ORIGIN=http://localhost:4100
# Hosted mode requires an absolute directory inside an attached persistent disk.
DATA_DIR=./data

# Hosted Turso storage (no Render disk required). Both remain server-side.
# DB_URL is an alias for TURSO_DATABASE_URL; local mode still uses native SQLite.
DB_URL=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Live EventSub endpoints. Override only for the Twitch CLI mock server.
EVENTSUB_WS_URL=wss://eventsub.wss.twitch.tv/ws
EVENTSUB_SUBSCRIPTIONS_URL=https://api.twitch.tv/helix/eventsub/subscriptions
